# Claude (content + niche research). https://console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube Data API v3 key, used for read-only niche research (search/video/channel stats).
# Google Cloud Console -> APIs & Services -> Credentials -> API key
YOUTUBE_API_KEY=

# Optional: Google Gemini API key for AI-illustrated stick-figure scenes (visual_style = "ai").
# https://aistudio.google.com/apikey  Without it, the built-in stick-figure renderer is used.
GEMINI_API_KEY=

# Optional: path to the OAuth client secret JSON (Desktop app) used for uploading.
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Optional (CI): the full contents of youtube_token.json produced by `ytagent auth`.
# YOUTUBE_TOKEN_JSON=
